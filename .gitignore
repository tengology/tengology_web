# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# media files — raw camera originals stay out of the repo
*.heic
*.HEIC
*.mov
*.MOV
*.mp4

# …but optimised web video under public/ is a site asset and must ship
!/public/**/*.mp4

# raw photo exports dumped in the repo root — site assets belong in public/
/*.jpg
/*.jpeg
/*.JPG
/*.JPEG
/*.png
/*.PNG

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template carries no secrets and documents what needs setting.
!.env.example

# prisma local db
prisma/dev.db
prisma/dev.db-journal

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
