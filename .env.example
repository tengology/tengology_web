# ─── Database (Supabase Postgres) ───────────────────
# Both URLs use Supabase's SESSION pooler (port 5432) — the VPS has no IPv6, so
# the direct db.<ref>.supabase.co host is unreachable, and the transaction
# pooler (6543) breaks migrations. Supabase signs its certificates with a
# private CA: download it from Project Settings → Database → SSL Configuration
# into prisma/certs/supabase-ca.crt. pg reads sslrootcert relative to the
# working directory, which is the repo root locally and /app in the container.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=prisma/certs/supabase-ca.crt"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=prisma/certs/supabase-ca.crt"

# ─── Auth ───────────────────────────────────────────
AUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3001"

# ─── Site ───────────────────────────────────────────
# Used to build order links inside transactional emails.
NEXT_PUBLIC_SITE_URL="http://localhost:3001"

# ─── Optional integrations ──────────────────────────
# The app runs without these; the related features degrade gracefully.

# AI listing assistant + designer stylist
ANTHROPIC_API_KEY=""

# Product image hosting
CLOUDINARY_URL=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# Transactional email — without a key, emails are logged as SKIPPED and
# orders still complete.
RESEND_API_KEY=""
EMAIL_FROM="Tengology <orders@tengology.com>"
ADMIN_EMAIL="hello@tengology.com"          # where new-order alerts are sent

# Square payments — checkout falls back to unpaid orders when absent.
# Credentials come from https://developer.squareup.com/apps
SQUARE_ACCESS_TOKEN=""                     # server-side only, never expose
SQUARE_ENVIRONMENT="sandbox"               # "sandbox" | "production"
SQUARE_LOCATION_ID=""
NEXT_PUBLIC_SQUARE_APPLICATION_ID=""       # browser card entry (safe to expose)
NEXT_PUBLIC_SQUARE_LOCATION_ID=""

# Square webhooks keep payment/refund state in sync when money moves outside
# checkout (dashboard refunds, disputes). The URL must exactly match the one
# registered in the Square dashboard or signature checks will fail.
SQUARE_WEBHOOK_SIGNATURE_KEY=""
SQUARE_WEBHOOK_URL="http://localhost:3001/api/webhooks/square"
